{"$id":"https://github.com/rattymcfarty/lift-kb/schemas/channel.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Release channel descriptor consumed by the app's KB sync.","properties":{"latest":{"pattern":"^\\d+\\.\\d+\\.\\d+$","type":"string"},"minAppVersion":{"pattern":"^\\d+\\.\\d+\\.\\d+$","type":"string"},"revoked":{"items":{"type":"string"},"type":"array"},"schemaVersion":{"minimum":1,"type":"integer"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"}},"required":["latest","minAppVersion","schemaVersion","sha256","revoked"],"title":"LIFT KB channel.json","type":"object"}